bin/
*.obj
*.exp
*.lib
*.pdb
# Imágenes en gris generadas desde data\img*.jpg con scripts\prepare_images.ps1
data/*.pgm
data/*.bmp
data/preview_*.png
# PNG a resolución completa (opcional --full-images): demasiado grandes para el repositorio
